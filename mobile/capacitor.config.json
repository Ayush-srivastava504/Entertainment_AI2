{
  "appId": "com.animegirl4u.app",
  "appName": "Animegirl4u",
  "webDir": "www",
  "backgroundColor": "#2A3FF0",
  "appendUserAgent": "Animegirl4uApp/1.0",
  "loggingBehavior": "none",
  "server": {
    "url": "https://animegirl4u.com",
    "androidScheme": "https",
    "errorPath": "offline.html",
    "allowNavigation": [
      "animegirl4u.com",
      "*.animegirl4u.com"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "LIGHT"
    }
  }
}
